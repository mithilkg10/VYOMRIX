# Vyomrix Security Platform - Example Environment Variables
# COPY THIS FILE TO .env AND REPLACE PLACEHOLDERS WITH REAL SECRETS IN PRODUCTION

# ==========================================
# Database Configuration
# ==========================================
POSTGRES_USER=vyomrix_user
POSTGRES_PASSWORD=vyomrix_secure_password
POSTGRES_DB=vyomrix_db

# ==========================================
# Message Broker Configuration
# ==========================================
RABBITMQ_USER=rabbitmq_user
RABBITMQ_PASS=rabbitmq_secure_password

# ==========================================
# Backend (FastAPI) Configuration
# ==========================================
SECRET_KEY=replace_with_a_32_character_secure_random_string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
ALLOWED_ORIGINS=https://your-production-domain.com

# ==========================================
# Third-Party API Keys (Integrations)
# ==========================================
GEMINI_API_KEY=placeholder_gemini_key
VIRUSTOTAL_API_KEY=placeholder_virustotal_key
ABUSEIPDB_API_KEY=placeholder_abuseipdb_key
OTX_API_KEY=placeholder_otx_key

# ==========================================
# Security Modules
# ==========================================
WAZUH_API_USER=wazuh_user
WAZUH_API_PASSWORD=wazuh_password
