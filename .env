# Vyorix Security Platform - Environment Variables

# ==========================================
# Database Configuration
# ==========================================
POSTGRES_USER=vyorix_admin
POSTGRES_PASSWORD=vyorix_secure_password_123!
POSTGRES_DB=vyorix_db

# ==========================================
# Backend (FastAPI) Configuration
# ==========================================
SECRET_KEY=generate_a_secure_random_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ==========================================
# Third-Party API Keys (Integrations)
# ==========================================
GEMINI_API_KEY=your_google_gemini_api_key_here
VIRUSTOTAL_API_KEY=your_virustotal_api_key_here
ABUSEIPDB_API_KEY=your_abuseipdb_api_key_here
OTX_API_KEY=your_alienvault_otx_api_key_here

# ==========================================
# Security Modules
# ==========================================
WAZUH_API_USER=wazuh
WAZUH_API_PASSWORD=wazuh_admin_password
