# Vyomrix Security Platform - Example Environment Variables
# COPY THIS FILE TO .env AND REPLACE PLACEHOLDERS WITH REAL SECRETS IN PRODUCTION

# ==========================================
# Core Deployment
# ==========================================
ENVIRONMENT=production
VYOMRIX_RUNTIME=production
VYOMRIX_SANDBOX=false

# ==========================================
# Database Configuration
# ==========================================
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=vyomrix_db
POSTGRES_SERVER=postgres
POSTGRES_PORT=5432

# ==========================================
# Redis Configuration
# ==========================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ==========================================
# Message Broker Configuration (RabbitMQ)
# ==========================================
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=
RABBITMQ_PASS=

# ==========================================
# Backend (FastAPI) Configuration
# ==========================================
# Both secrets must be distinct and at least 32 characters long
SECRET_KEY=
CSRF_SECRET=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
ALLOWED_ORIGINS=

# ==========================================
# Third-Party API Keys (Integrations)
# ==========================================
GEMINI_API_KEY=
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
OTX_API_KEY=

# ==========================================
# Wazuh Integration
# ==========================================
WAZUH_MANAGER_URL=
WAZUH_MANAGER_USER=
WAZUH_MANAGER_PASSWORD=
WAZUH_INDEXER_URL=
WAZUH_INDEXER_USER=
WAZUH_INDEXER_PASSWORD=
WAZUH_VERIFY_TLS=true
# WAZUH_CA_BUNDLE=/path/to/custom/ca.pem

